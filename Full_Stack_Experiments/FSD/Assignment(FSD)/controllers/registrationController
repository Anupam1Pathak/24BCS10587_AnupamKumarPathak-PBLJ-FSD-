const mongoose = require("mongoose");
const Registration = require("../models/Registration");
const {
  calculateFinalAmount,
  getValidationMessages,
} = require("../utils/registrationHelpers");

const ALLOWED_FIELDS = [
  "studentName",
  "collegeEmail",
  "rollNumber",
  "eventType",
  "teamSize",
  "ticketPrice",
  "discountCode",
  "status",
  "registrationDate",
];

function pickAllowedFields(body) {
  const picked = {};
  for (const field of ALLOWED_FIELDS) {
    if (Object.prototype.hasOwnProperty.call(body, field)) {
      picked[field] = body[field];
    }
  }
  return picked;
}

function handleKnownError(res, error) {
  if (error.statusCode === 400 && error.message === "Invalid discount code") {
    return res.status(400).json({
      success: false,
      message: "Invalid discount code",
    });
  }

  if (error.code === 11000) {
    return res.status(409).json({
      success: false,
      message: "This email is already registered for the event",
    });
  }

  if (error.name === "ValidationError") {
    return res.status(400).json({
      success: false,
      message: "Validation failed",
      errors: getValidationMessages(error),
    });
  }

  if (error.name === "CastError") {
    return res.status(400).json({
      success: false,
      message: `Invalid value for ${error.path}`,
    });
  }

  console.error("Registration controller error:", error.message);
  return res.status(500).json({
    success: false,
    message: "Internal server error",
  });
}

// POST /api/registrations
async function createRegistration(req, res) {
  try {
    const data = pickAllowedFields(req.body);

    if (data.discountCode !== undefined && data.discountCode !== null) {
      data.discountCode = String(data.discountCode).trim().toUpperCase();
      if (data.discountCode === "") delete data.discountCode;
    }

    // Require a ticket price before calculating the final amount.
    if (
      data.ticketPrice === undefined ||
      data.ticketPrice === null ||
      data.ticketPrice === ""
    ) {
      return res.status(400).json({
        success: false,
        message: "Validation failed",
        errors: ["Ticket price is required"],
      });
    }

    const ticketPrice = Number(data.ticketPrice);
    if (!Number.isFinite(ticketPrice)) {
      return res.status(400).json({
        success: false,
        message: "Validation failed",
        errors: ["Ticket price must be a valid number"],
      });
    }

    data.ticketPrice = ticketPrice;
    data.finalAmount = calculateFinalAmount(ticketPrice, data.discountCode);

    const registration = await Registration.create(data);

    return res.status(201).json({
      success: true,
      message: "Registration successful",
      data: registration,
    });
  } catch (error) {
    return handleKnownError(res, error);
  }
}

// GET /api/registrations?eventType=ROBOTICS&status=CONFIRMED
async function getRegistrations(req, res) {
  try {
    const filter = {};
    if (req.query.eventType)
      filter.eventType = String(req.query.eventType).trim().toUpperCase();
    if (req.query.status)
      filter.status = String(req.query.status).trim().toUpperCase();

    const registrations = await Registration.find(filter).sort({
      registrationDate: -1,
    });

    return res.status(200).json({
      success: true,
      count: registrations.length,
      data: registrations,
    });
  } catch (error) {
    return handleKnownError(res, error);
  }
}

// GET /api/registrations/:id
async function getRegistrationById(req, res) {
  try {
    if (!mongoose.isValidObjectId(req.params.id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid registration ID format",
      });
    }

    const registration = await Registration.findById(req.params.id);
    if (!registration) {
      return res.status(404).json({
        success: false,
        message: "Registration not found",
      });
    }

    return res.status(200).json({
      success: true,
      data: registration,
    });
  } catch (error) {
    return handleKnownError(res, error);
  }
}

// PUT /api/registrations/:id
async function updateRegistration(req, res) {
  try {
    if (!mongoose.isValidObjectId(req.params.id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid registration ID format",
      });
    }

    const existing = await Registration.findById(req.params.id);
    if (!existing) {
      return res.status(404).json({
        success: false,
        message: "Registration not found",
      });
    }

    const updates = pickAllowedFields(req.body);

    // Build the complete updated record so cross-field rules also work
    // when only one of eventType/teamSize is sent by the client.
    const merged = {
      studentName: updates.studentName ?? existing.studentName,
      collegeEmail: updates.collegeEmail ?? existing.collegeEmail,
      rollNumber: updates.rollNumber ?? existing.rollNumber,
      eventType: updates.eventType ?? existing.eventType,
      teamSize: updates.teamSize ?? existing.teamSize,
      ticketPrice: updates.ticketPrice ?? existing.ticketPrice,
      discountCode: Object.prototype.hasOwnProperty.call(
        updates,
        "discountCode",
      )
        ? updates.discountCode
        : existing.discountCode,
      status: updates.status ?? existing.status,
      registrationDate: updates.registrationDate ?? existing.registrationDate,
    };

    if (merged.discountCode !== undefined && merged.discountCode !== null) {
      merged.discountCode = String(merged.discountCode).trim().toUpperCase();
      if (merged.discountCode === "") merged.discountCode = undefined;
    }

    if (merged.eventType === "AI_WORKSHOP" && Number(merged.teamSize) !== 1) {
      return res.status(400).json({
        success: false,
        message: "Validation failed",
        errors: ["AI Workshop only permits individual registrations"],
      });
    }

    const price = Number(merged.ticketPrice);
    if (!Number.isFinite(price)) {
      return res.status(400).json({
        success: false,
        message: "Validation failed",
        errors: ["Ticket price must be a valid number"],
      });
    }

    // finalAmount is computed by the server; ignore any client-sent value.
    merged.ticketPrice = price;
    merged.finalAmount = calculateFinalAmount(price, merged.discountCode);

    // runValidators:true is explicitly included to satisfy the assignment.
    const updated = await Registration.findByIdAndUpdate(
      req.params.id,
      merged,
      {
        new: true,
        runValidators: true,
        context: "query",
      },
    );

    return res.status(200).json({
      success: true,
      message: "Registration updated successfully",
      data: updated,
    });
  } catch (error) {
    return handleKnownError(res, error);
  }
}

// DELETE /api/registrations/:id
async function deleteRegistration(req, res) {
  try {
    if (!mongoose.isValidObjectId(req.params.id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid registration ID format",
      });
    }

    const deleted = await Registration.findByIdAndDelete(req.params.id);
    if (!deleted) {
      return res.status(404).json({
        success: false,
        message: "Registration not found",
      });
    }

    return res.status(200).json({
      success: true,
      message: "Registration deleted successfully",
      data: deleted,
    });
  } catch (error) {
    return handleKnownError(res, error);
  }
}

module.exports = {
  createRegistration,
  getRegistrations,
  getRegistrationById,
  updateRegistration,
  deleteRegistration,
};
